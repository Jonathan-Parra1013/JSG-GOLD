{%- comment -%}
  Full Cart Template for JSG GOLD (WhatsApp Pago Contra Entrega Only)
{%- endcomment -%}

<section class="section" style="padding: 60px 0; background: #fafafa; min-height: 70vh;">
  <div class="container" style="max-width: 900px; margin: 0 auto;">
    <h1 style="font-family: var(--font-heading); font-size: 2rem; font-weight: 700; text-transform: uppercase; margin-bottom: 30px; border-bottom: 2px solid var(--color-gold); padding-bottom: 10px;">
      Tu Carrito de Compra
    </h1>

    {% if cart.item_count > 0 %}
      <div style="background: #ffffff; border-radius: 8px; padding: 25px; border: 1px solid #e0e0e0; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
        
        <div class="cart-items-list" style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px;">
          {% for item in cart.items %}
            {% render 'cart-item', item: item %}
          {% endfor %}
        </div>

        <div style="border-top: 2px dashed #eee; padding-top: 20px; display: flex; flex-direction: column; align-items: flex-end; gap: 15px;">
          <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-black);">
            Subtotal: <span style="color: var(--color-gold-dark);">{{ cart.total_price | money }}</span>
          </div>

          <p style="font-size: 0.85rem; color: #666; margin: 0; text-align: right;">
            🚚 Envío Gratis y Pago Contra Entrega a toda Colombia.<br>Al presionar el botón se enviará tu lista de compra directamente a nuestro WhatsApp oficial.
          </p>

          <button type="button" id="whatsapp-page-checkout-btn" class="btn btn-primary btn-lg" style="width: 100%; max-width: 400px; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">
            Pedir por WhatsApp (Pago Contra Entrega)
          </button>

          <a href="/collections/all" style="color: #666; font-size: 0.9rem; text-decoration: underline;">
            Continuar comprando
          </a>
        </div>

      </div>
    {% else %}
      <div style="text-align: center; padding: 60px 20px; background: #fff; border-radius: 8px; border: 1px solid #eee;">
        <h2 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 15px; color: #555;">
          Tu carrito está vacío
        </h2>
        <p style="color: #777; margin-bottom: 25px;">Agrega tus joyas preferidas en Oro Laminado 18K para comenzar tu pedido.</p>
        <a href="/collections/all" class="btn btn-primary">
          Ver Catálogo Completo
        </a>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('whatsapp-page-checkout-btn');
    if (btn && window.JSGCart) {
      btn.addEventListener('click', () => {
        window.JSGCart.bindWhatsAppCheckout();
      });
    }
  });
</script>
