{%- comment -%}
  Default Page Template for JSG GOLD
{%- endcomment -%}

<section class="section" style="padding: 60px 0; background: #ffffff;">
  <div class="container" style="max-width: 800px; margin: 0 auto;">
    <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--color-black); margin-bottom: 25px; border-bottom: 2px solid var(--color-gold); padding-bottom: 10px;">
      {{ page.title }}
    </h1>
    <div class="page-content" style="line-height: 1.8; color: #333; font-size: 1rem;">
      {{ page.content }}
    </div>
  </div>
</section>
