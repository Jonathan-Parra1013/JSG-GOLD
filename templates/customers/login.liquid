<!-- JSG GOLD - Luxury Customer Login Template -->
<div class="jsg-login-page">

  <div class="jsg-login-card">

    <!-- Brand -->
    <div class="jsg-login-brand">
      <a href="{{ routes.root_url }}" style="display: contents;">
        <img src="{{ 'jsg-logo.png' | asset_url }}" alt="JSG GOLD">
        <div class="jsg-login-brand-text">
          <span class="jsg-login-brand-name">JSG GOLD</span>
          <span class="jsg-login-brand-sub">ORO LAMINADO 18K</span>
        </div>
      </a>
    </div>

    <!-- Title -->
    <h1 class="jsg-login-title">Iniciar Sesión</h1>
    <p class="jsg-login-subtitle">
      Accede a tu cuenta VIP · <a href="{{ routes.account_register_url }}">Crear cuenta gratis</a>
    </p>

    <!-- Benefit pills -->
    <div class="jsg-login-benefits">
      <span class="jsg-login-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Pago seguro
      </span>
      <span class="jsg-login-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Rastreo de pedidos
      </span>
      <span class="jsg-login-pill">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        Beneficios VIP
      </span>
    </div>

    <!-- Login Form -->
    <div id="CustomerLoginForm">
      {%- form 'customer_login' -%}

        {%- if form.errors -%}
          <ul class="jsg-login-errors">
            {% for error in form.errors %}
              <li>{{ form.errors.messages[error] }}</li>
            {% endfor %}
          </ul>
        {%- endif -%}

        <div class="jsg-login-field">
          <label for="CustomerEmail">Correo Electrónico</label>
          <input type="email"
                 name="customer[email]"
                 id="CustomerEmail"
                 autocomplete="email"
                 autocapitalize="off"
                 autocorrect="off"
                 placeholder="ejemplo@correo.com"
                 required>
        </div>

        <div class="jsg-login-field">
          <label for="CustomerPassword">Contraseña</label>
          <input type="password"
                 name="customer[password]"
                 id="CustomerPassword"
                 autocomplete="current-password"
                 placeholder="••••••••"
                 required>
        </div>

        <button type="submit" class="jsg-login-btn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Iniciar Sesión
        </button>

        <a href="#recover" id="RecoverPasswordBtn" class="jsg-login-forgot">
          ¿Olvidaste tu contraseña?
        </a>

      {%- endform -%}
    </div>

    <!-- Recover Password Form (hidden by default) -->
    <div id="RecoverPasswordForm" style="display: none;">
      <h2 class="jsg-login-title" style="font-size: 1.25rem; margin-bottom: 0.5rem;">Recuperar Contraseña</h2>
      <p class="jsg-login-subtitle">Ingresa tu correo y te enviaremos un enlace seguro.</p>

      {%- form 'recover_customer_password' -%}
        {%- if form.errors -%}
          <ul class="jsg-login-errors">
            {% for error in form.errors %}
              <li>{{ form.errors.messages[error] }}</li>
            {% endfor %}
          </ul>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #34D399; padding: 0.85rem 1rem; border-radius: 10px; font-size: 0.85rem; margin-bottom: 1rem; text-align: center;">
            ✓ Te enviamos un correo con las instrucciones.
          </div>
        {%- endif -%}

        <div class="jsg-login-field">
          <label for="RecoverEmail">Correo Electrónico</label>
          <input type="email" name="email" id="RecoverEmail" autocomplete="email" required placeholder="ejemplo@correo.com">
        </div>

        <button type="submit" class="jsg-login-btn" style="margin-bottom: 0.75rem;">
          Enviar Enlace de Recuperación
        </button>

        <button type="button" id="HideRecoverPasswordBtn" class="jsg-login-forgot" style="background: none; border: none; cursor: pointer; width: 100%;">
          ← Volver al inicio de sesión
        </button>
      {%- endform -%}
    </div>

    <!-- Divider -->
    <div class="jsg-login-divider"><span>o</span></div>

    <!-- Register CTA -->
    <a href="{{ routes.account_register_url }}" class="mobile-menu-btn-secondary" style="text-align: center; display: block;">
      Crear cuenta VIP gratis
    </a>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const recoverBtn = document.getElementById('RecoverPasswordBtn');
    const hideRecoverBtn = document.getElementById('HideRecoverPasswordBtn');
    const loginForm = document.getElementById('CustomerLoginForm');
    const recoverForm = document.getElementById('RecoverPasswordForm');

    if (recoverBtn && hideRecoverBtn && loginForm && recoverForm) {
      recoverBtn.addEventListener('click', (e) => {
        e.preventDefault();
        loginForm.style.display = 'none';
        recoverForm.style.display = 'block';
      });

      hideRecoverBtn.addEventListener('click', (e) => {
        e.preventDefault();
        recoverForm.style.display = 'none';
        loginForm.style.display = 'block';
      });

      if (window.location.hash === '#recover') {
        loginForm.style.display = 'none';
        recoverForm.style.display = 'block';
      }
    }
  });
</script>
