{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign media_count = product.media.size -%}

<div class="product-detail-page" itemscope itemtype="http://schema.org/Product">
  <div class="container">
    <div class="product-detail-layout">

      <!-- Gallery -->
      <div class="detail-gallery" data-product-gallery>
        <!-- Main Image -->
        <div class="detail-main-image-wrap">
          {%- if product.featured_media -%}
            <a href="{{ product.featured_media | image_url: width: 1200 }}"
               data-pswp-src="{{ product.featured_media | image_url: width: 1200 }}"
               class="detail-main-image-link">
              {{ product.featured_media | image_url: width: 800 | image_tag:
                id: 'main-product-image',
                class: 'detail-main-image',
                loading: 'eager',
                alt: product.featured_media.alt | escape | default: product.title,
                widths: '500, 700, 800',
                data-main-image: ''
              }}
            </a>
          {%- endif -%}
        </div>

        <!-- Thumbnails -->
        {%- if media_count > 1 -%}
          <div class="detail-thumbs-row" role="list" aria-label="Imágenes del producto">
            {%- for media in product.media limit: 5 -%}
              <button type="button"
                      class="detail-thumb {% if forloop.first %}active{% endif %}"
                      role="listitem"
                      data-thumb-index="{{ forloop.index0 }}"
                      data-media-src="{{ media | image_url: width: 800 }}"
                      data-media-zoom-src="{{ media | image_url: width: 1200 }}"
                      aria-label="Ver imagen {{ forloop.index }}">
                {{ media | image_url: width: 120 | image_tag:
                  alt: media.alt | escape | default: product.title,
                  loading: 'lazy',
                  widths: '80, 120'
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="detail-info" itemprop="name">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Navegación de migas de pan" style="margin-bottom: 0.5rem;">
          <a href="{{ routes.root_url }}" style="color: #6B7280; font-size: 0.85rem; text-decoration: none;">Inicio</a>
          <span aria-hidden="true" style="color: var(--gold-dark); margin: 0 4px;">›</span>
          {%- if collection -%}
            <a href="{{ collection.url }}" style="color: #6B7280; font-size: 0.85rem; text-decoration: none;">{{ collection.title }}</a>
            <span aria-hidden="true" style="color: var(--gold-dark); margin: 0 4px;">›</span>
          {%- endif -%}
          <span aria-current="page" style="color: #855A00; font-size: 0.85rem; font-weight: 600;">{{ product.title }}</span>
        </nav>

        <h1 class="detail-title" itemprop="name" style="font-family: var(--font-display); font-size: 1.85rem; font-weight: 800; text-transform: uppercase; color: #111827; line-height: 1.25; margin-bottom: 0.75rem;">
          {{ product.title }}
        </h1>

        <!-- Reviews Summary (stars) -->
        <div class="detail-rating-row" style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.2rem; padding-bottom: 0;">
          <div class="stars-wrap" aria-hidden="true" style="color: #F59E0B; font-size: 1.1rem; letter-spacing: 2px;">★★★★★</div>
          <span style="font-weight: 700; color: #111827;">5.0 / 5.0</span>
          {%- if product.metafields.reviews.rating_count -%}
            <span style="color: var(--text-muted); font-size: 0.85rem;">({{ product.metafields.reviews.rating_count }} reseñas)</span>
          {%- endif -%}
        </div>

        <!-- Price Box -->
        <div class="detail-price-box" style="background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 10px; padding: 1.1rem 1.4rem; display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem;">
          <div itemprop="offers" itemscope itemtype="http://schema.org/Offer">
            <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
            <meta itemprop="price" content="{{ current_variant.price | divided_by: 100 }}">
            <link itemprop="availability" href="http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="original-price" itemprop="highPrice" style="font-size: 1rem; color: #9CA3AF; margin-right: 8px;">
                <s>{{ current_variant.compare_at_price | money }}</s>
              </span>
            {%- endif -%}
            <span class="detail-price" id="product-price" itemprop="price" style="font-size: 2rem; font-weight: 800; color: #111827;">
              {{ current_variant.price | money }}
            </span>
          </div>

          <div class="detail-stock-badge" style="display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.85rem; color: #10B981;">
            {%- if current_variant.available -%}
              <span style="width: 8px; height: 8px; background: #10B981; border-radius: 50%; display: inline-block;"></span>
              En Stock
              {%- if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity < 10 -%}
                <span style="color:#EF4444;">(¡Últimas {{ current_variant.inventory_quantity }}!)</span>
              {%- endif -%}
            {%- else -%}
              <span style="width: 8px; height: 8px; background: #EF4444; border-radius: 50%; display: inline-block;"></span>
              Agotado
            {%- endif -%}
          </div>
        </div>

        <!-- Product Form (variants + add to cart) -->
        {%- form 'product', product, id: 'product-form', data-product-form: '', novalidate: '' -%}
          <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="product-variants-section" style="margin-bottom: 1.5rem;">
              {%- for option in product.options_with_values -%}
                <div class="options-group" style="margin-bottom: 1rem;">
                  <div class="option-title" style="font-size: 0.85rem; font-weight: 800; text-transform: uppercase; color: #111827; margin-bottom: 0.6rem; letter-spacing: 0.5px;">
                    {{ option.name }}:
                    <span class="option-selected-value" id="option-val-{{ forloop.index }}" style="color: #B45309; font-weight: 700; text-transform: none;">
                      {{ option.selected_value }}
                    </span>
                  </div>
                  <div class="option-chips" role="group" aria-label="Seleccionar {{ option.name }}" style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
                    {%- for value in option.values -%}
                      <button type="button"
                              class="option-chip {% if option.selected_value == value %}active{% endif %}"
                              data-option-position="{{ option.position }}"
                              data-option-value="{{ value | escape }}"
                              aria-pressed="{{ option.selected_value == value }}"
                              style="padding: 0.6rem 1.1rem; border-radius: 6px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.2s ease; {% if option.selected_value == value %}background: #000000; color: #ffffff; border: 1px solid #000000;{% else %}background: #ffffff; color: #111827; border: 1px solid #D1D5DB;{% endif %}">
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Product description snippets (short) -->
          {%- if product.description != blank -%}
            <div class="detail-desc product-description" itemprop="description" style="font-size: 0.92rem; color: #4B5563; line-height: 1.65; margin-bottom: 1.5rem;">
              {{ product.description | strip_html | truncate: 360 }}
              {%- if product.description | strip_html | size > 360 -%}
                <a href="#product-full-description" class="read-more-link" style="color: #111827; font-weight: 600; text-decoration: underline; margin-left: 4px;">Leer más ↓</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- CTA Buttons (Side by Side matching Image 1) -->
          <div class="detail-cta-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 1.25rem;">
            <!-- Add to Cart -->
            <button type="submit"
                    name="add"
                    class="btn shine-hover"
                    id="add-to-cart-btn"
                    data-add-to-cart
                    {% unless current_variant.available %}disabled{% endunless %}
                    style="background: linear-gradient(180deg, #EED28B 0%, #D4AF37 50%, #B88B2A 100%); color: #000000; font-weight: 800; text-transform: uppercase; font-size: 0.92rem; letter-spacing: 0.5px; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 8px; padding: 16px 14px; border: none; cursor: pointer; box-shadow: 0 4px 15px rgba(212,175,55,0.35);">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span>AÑADIR AL CARRITO</span>
            </button>

            <!-- WhatsApp Direct Buy -->
            <button type="button"
                    class="btn shine-hover"
                    data-action="whatsapp-buy-now"
                    data-product-title="{{ product.title | escape }}"
                    data-product-url="{{ shop.url }}{{ product.url }}"
                    data-variant-title="{{ current_variant.title | escape }}"
                    data-variant-price="{{ current_variant.price | money_without_currency }}"
                    {% unless current_variant.available %}disabled{% endunless %}
                    style="background: #00A859; color: #ffffff; font-weight: 800; text-transform: uppercase; font-size: 0.88rem; letter-spacing: 0.5px; display: flex; align-items: center; justify-content: center; gap: 8px; border-radius: 8px; padding: 16px 14px; border: none; cursor: pointer; box-shadow: 0 4px 15px rgba(0,168,89,0.3);">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-2.228-.567-1.748-.724-2.885-2.529-2.973-2.645-.088-.116-.708-.941-.708-1.792s.445-1.272.604-1.444c.159-.172.347-.216.463-.216.116 0 .232.002.333.007.106.006.248-.041.388.295.144.347.491 1.2.535 1.288.043.088.073.188.014.304-.058.116-.087.188-.173.289l-.26.307c-.087.087-.179.183-.077.359.102.176.452.746.97 1.208.667.596 1.23.78 1.403.867.174.087.275.073.377-.044.101-.116.435-.507.55-.681.116-.174.232-.145.39-.087.159.058 1.009.477 1.183.564.174.087.29.13.333.203.044.073.044.423-.1.828z"/>
                <path d="M20.52 3.449C18.24 1.245 15.24 0 12 0 5.373 0 0 5.373 0 12c0 2.117.553 4.17 1.604 5.978L0 24l6.184-1.622A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12 0-3.203-1.243-6.219-3.48-8.551zM12 22c-1.786 0-3.538-.481-5.07-1.391l-.363-.215-3.671.963.98-3.581-.236-.371A9.96 9.96 0 012 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
              </svg>
              <span>PEDIR AHORA POR WHATSAPP</span>
            </button>
          </div>

          <!-- COD Trust Notice -->
          <div class="product-cod-trust" style="background: #E8F8F0; border: 1px solid #A3E5C2; border-radius: 8px; padding: 14px 16px; margin-top: 15px; color: #166534;">
            <div style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 600;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span><strong>Pago Contra Entrega:</strong> Pagas cuando recibas tu joya. Sin tarjeta. Sin riesgo.</span>
            </div>
          </div>

          <!-- Payment Options Badges Box -->
          <div style="background: #F9FAFB; border: 1px solid #E5E7EB; border-radius: 8px; padding: 14px 16px; margin-top: 12px;">
            <span style="display: block; font-size: 0.76rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #374151; margin-bottom: 8px;">
              💳 MÉTODOS DE PAGO DISPONIBLES EN COLOMBIA:
            </span>
            <div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 8px;">
              <span style="background: #002B49; color: #ffffff; font-size: 0.72rem; font-weight: 900; padding: 3px 8px; border-radius: 4px; letter-spacing: 1px;">PSE</span>
              <span style="background: #1A1D24; color: #ffffff; font-size: 0.7rem; font-weight: 700; padding: 3px 8px; border-radius: 4px;">TARJETA CRÉDITO / DÉBITO</span>
              <span style="background: #200020; color: #FF2B6D; font-size: 0.7rem; font-weight: 800; padding: 3px 8px; border-radius: 4px;">NEQUI</span>
              <span style="background: #004481; color: #ffffff; font-size: 0.7rem; font-weight: 800; padding: 3px 8px; border-radius: 4px;">BANCOLOMBIA</span>
              <span style="background: rgba(37,211,102,0.15); color: #166534; font-size: 0.7rem; font-weight: 800; padding: 3px 8px; border-radius: 4px;">PAGO CONTRA ENTREGA</span>
            </div>
            <p style="font-size: 0.76rem; color: #6B7280; margin: 0; line-height: 1.4;">
              Paga en línea seguro con <strong>PSE o Tarjeta</strong>, o solicita tu pedido con <strong>Pago Contra Entrega</strong> en efectivo.
            </p>
          </div>

        {%- endform -%}

        <!-- Variants hidden JSON for JS -->
        <script type="application/json" id="product-variants-json">
          {{ product.variants | json }}
        </script>
      </div>
    </div>

    <!-- Full Product Description / Specs -->
    {%- if product.description != blank -%}
      <div class="product-full-description" id="product-full-description">
        <h2 class="section-title" style="font-size: 1.5rem; margin-bottom: 1.5rem;">Descripción y Especificaciones Técnicas</h2>
        <div class="rich-text">
          {{ product.description }}
        </div>
      </div>
    {%- endif -%}

    <!-- Related Products -->
    {%- if collection -%}
      {%- assign related_products = collection.products | where: 'id', '!=', product.id -%}
      {%- if related_products.size > 0 -%}
        <div class="related-products-section" style="margin-top: 4rem;">
          <div class="section-header">
            <span class="section-subtitle">También te puede interesar</span>
            <h2 class="section-title" style="font-size: 1.85rem;">Más Joyas de Poder JSG Gold</h2>
          </div>
          <div class="products-grid">
            {%- for related_product in related_products limit: 4 -%}
              {%- unless related_product.id == product.id -%}
                {%- render 'product-card', product: related_product -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

<script>
  // Pass product data to product-form.js
  window.productData = {{ product | json }};
  window.selectedVariantId = {{ current_variant.id | json }};
</script>
{{ 'product-form.js' | asset_url | script_tag }}
