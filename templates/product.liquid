{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign media_count = product.media.size -%}

<div class="product-detail-page" itemscope itemtype="http://schema.org/Product">
  <div class="container">
    <div class="product-detail-layout">

      <!-- Gallery -->
      <div class="detail-gallery" data-product-gallery>
        <!-- Main Image -->
        <div class="detail-main-image-wrap">
          {%- if product.featured_media -%}
            <a href="{{ product.featured_media | image_url: width: 1200 }}"
               data-pswp-src="{{ product.featured_media | image_url: width: 1200 }}"
               class="detail-main-image-link">
              {{ product.featured_media | image_url: width: 800 | image_tag:
                id: 'main-product-image',
                class: 'detail-main-image',
                loading: 'eager',
                alt: product.featured_media.alt | escape | default: product.title,
                widths: '500, 700, 800',
                data-main-image: ''
              }}
            </a>
          {%- endif -%}
        </div>

        <!-- Thumbnails -->
        {%- if media_count > 1 -%}
          <div class="detail-thumbs-row" role="list" aria-label="Imágenes del producto">
            {%- for media in product.media limit: 5 -%}
              <button class="detail-thumb {% if forloop.first %}active{% endif %}"
                      role="listitem"
                      data-thumb-index="{{ forloop.index0 }}"
                      data-media-src="{{ media | image_url: width: 800 }}"
                      aria-label="Ver imagen {{ forloop.index }}">
                {{ media | image_url: width: 150 | image_tag:
                  alt: media.alt | escape | default: product.title,
                  loading: 'lazy',
                  widths: '70, 120, 150'
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="detail-info" itemprop="name">
        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="Navegación de migas de pan">
          <a href="{{ routes.root_url }}">Inicio</a>
          <span aria-hidden="true">›</span>
          {%- if collection -%}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
            <span aria-hidden="true">›</span>
          {%- endif -%}
          <span aria-current="page">{{ product.title }}</span>
        </nav>

        {%- if product.type != blank -%}
          <span class="detail-header-tag">
            {%- render 'icon-star', size: 14 -%}
            {{ product.type | upcase }} • JSG GOLD EXCLUSIVE
          </span>
        {%- endif -%}

        <h1 class="detail-title" itemprop="name">{{ product.title }}</h1>

        <!-- Reviews Summary (stars) -->
        <div class="detail-rating-row">
          <div class="stars-wrap" aria-hidden="true" style="color: #F59E0B; font-size: 1.1rem;">★★★★★</div>
          <span style="font-weight: 700;">5.0 / 5.0</span>
          {%- if product.metafields.reviews.rating_count -%}
            <span style="color: var(--text-muted); font-size: 0.85rem;">({{ product.metafields.reviews.rating_count }} reseñas)</span>
          {%- endif -%}
        </div>

        <!-- Price Box -->
        <div class="detail-price-box">
          <div itemprop="offers" itemscope itemtype="http://schema.org/Offer">
            <meta itemprop="priceCurrency" content="{{ cart.currency.iso_code }}">
            <meta itemprop="price" content="{{ current_variant.price | divided_by: 100 }}">
            <link itemprop="availability" href="http://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}">

            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="original-price" itemprop="highPrice" style="font-size: 1rem;">
                <s>{{ current_variant.compare_at_price | money }}</s>
              </span>
            {%- endif -%}
            <span class="detail-price" id="product-price" itemprop="price">
              {{ current_variant.price | money }}
            </span>
          </div>

          <div class="detail-stock-badge">
            {%- if current_variant.available -%}
              <svg width="12" height="12" fill="#10B981" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
              En Stock
              {%- if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity < 10 -%}
                <span style="color:#EF4444;">(¡Últimas {{ current_variant.inventory_quantity }}!)</span>
              {%- endif -%}
            {%- else -%}
              <svg width="12" height="12" fill="#EF4444" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/></svg>
              Agotado
            {%- endif -%}
          </div>
        </div>

        <!-- Product Form (variants + add to cart) -->
        {%- form 'product', product, id: 'product-form', data-product-form: '', novalidate: '' -%}
          <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="product-variants-section">
              {%- for option in product.options_with_values -%}
                <div class="options-group">
                  <div class="option-title">
                    {{ option.name }}:
                    <span class="option-selected-value" id="option-val-{{ forloop.index }}">
                      {{ option.selected_value }}
                    </span>
                  </div>
                  <div class="option-chips" role="group" aria-label="Seleccionar {{ option.name }}">
                    {%- for value in option.values -%}
                      <button type="button"
                              class="option-chip {% if option.selected_value == value %}active{% endif %}"
                              data-option-position="{{ option.position }}"
                              data-option-value="{{ value | escape }}"
                              aria-pressed="{{ option.selected_value == value }}">
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Product description snippets (short) -->
          {%- if product.description != blank -%}
            <div class="detail-desc product-description" itemprop="description">
              {{ product.description | strip_html | truncate: 400 }}
              {%- if product.description | strip_html | size > 400 -%}
                <a href="#product-full-description" class="read-more-link">Leer más ↓</a>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- CTA Buttons -->
          <div class="detail-cta-row">
            <!-- Add to Cart (opens drawer) -->
            <button type="submit"
                    name="add"
                    class="btn btn-gold shine-hover"
                    id="add-to-cart-btn"
                    data-add-to-cart
                    {% unless current_variant.available %}disabled{% endunless %}>
              {%- render 'icon-cart', size: 20 -%}
              {%- if current_variant.available -%}
                Añadir al Carrito
              {%- else -%}
                Agotado Temporalmente
              {%- endif -%}
            </button>

            <!-- WhatsApp Direct Buy -->
            <button type="button"
                    class="btn btn-whatsapp shine-hover"
                    data-action="whatsapp-buy-now"
                    data-product-title="{{ product.title | escape }}"
                    data-product-url="{{ shop.url }}{{ product.url }}"
                    data-variant-title="{{ current_variant.title | escape }}"
                    data-variant-price="{{ current_variant.price | money_without_currency }}"
                    {% unless current_variant.available %}disabled{% endunless %}>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.068-2.228-.567-1.748-.724-2.885-2.529-2.973-2.645-.088-.116-.708-.941-.708-1.792s.445-1.272.604-1.444c.159-.172.347-.216.463-.216.116 0 .232.002.333.007.106.006.248-.041.388.295.144.347.491 1.2.535 1.288.043.088.073.188.014.304-.058.116-.087.188-.173.289l-.26.307c-.087.087-.179.183-.077.359.102.176.452.746.97 1.208.667.596 1.23.78 1.403.867.174.087.275.073.377-.044.101-.116.435-.507.55-.681.116-.174.232-.145.39-.087.159.058 1.009.477 1.183.564.174.087.29.13.333.203.044.073.044.423-.1.828z"/>
                <path d="M20.52 3.449C18.24 1.245 15.24 0 12 0 5.373 0 0 5.373 0 12c0 2.117.553 4.17 1.604 5.978L0 24l6.184-1.622A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12 0-3.203-1.243-6.219-3.48-8.551zM12 22c-1.786 0-3.538-.481-5.07-1.391l-.363-.215-3.671.963.98-3.581-.236-.371A9.96 9.96 0 012 12c0-5.514 4.486-10 10-10s10 4.486 10 10-4.486 10-10 10z"/>
              </svg>
              Pedir Ahora por WhatsApp
            </button>
          </div>

          <!-- COD Trust Notice -->
          <div class="product-cod-trust">
            {%- render 'icon-shield', size: 16 -%}
            <span>
              <strong>Pago Contra Entrega:</strong> Pagas cuando recibas tu joya. Sin tarjeta. Sin riesgo.
              <br>
              {%- render 'icon-check', size: 14 -%} Envío asegurado • {%- render 'icon-check', size: 14 -%} Cofre de Lujo incluido
            </span>
          </div>

        {%- endform -%}

        <!-- Variants hidden JSON for JS -->
        <script type="application/json" id="product-variants-json">
          {{ product.variants | json }}
        </script>
      </div>
    </div>

    <!-- Full Product Description / Specs -->
    {%- if product.description != blank -%}
      <div class="product-full-description" id="product-full-description">
        <h2 class="section-title" style="font-size: 1.5rem; margin-bottom: 1.5rem;">Descripción y Especificaciones Técnicas</h2>
        <div class="rich-text">
          {{ product.description }}
        </div>
      </div>
    {%- endif -%}

    <!-- Related Products -->
    {%- if collection -%}
      {%- assign related_products = collection.products | where: 'id', '!=', product.id -%}
      {%- if related_products.size > 0 -%}
        <div class="related-products-section" style="margin-top: 4rem;">
          <div class="section-header">
            <span class="section-subtitle">También te puede interesar</span>
            <h2 class="section-title" style="font-size: 1.85rem;">Más Joyas de Poder JSG Gold</h2>
          </div>
          <div class="products-grid">
            {%- for related_product in related_products limit: 4 -%}
              {%- unless related_product.id == product.id -%}
                {%- render 'product-card', product: related_product -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

  </div>
</div>

<script>
  // Pass product data to product-form.js
  window.productData = {{ product | json }};
  window.selectedVariantId = {{ current_variant.id | json }};
</script>
{{ 'product-form.js' | asset_url | script_tag }}
