{% if section.settings.show_bar %}
<div class="announcement-bar" role="banner">
  <div class="announcement-bar__container">
    <div class="announcement-bar__item">
      {%- render 'icon-shield' -%}
      <span>{{ section.settings.text_1 }}</span>
    </div>
    <div class="announcement-bar__ticker hide-mobile">
      <div class="announcement-bar__item">
        {%- render 'icon-check' -%}
        <span>{{ section.settings.text_2 }}</span>
      </div>
      <div class="announcement-bar__item">
        {%- render 'icon-star' -%}
        <span>{{ section.settings.text_3 }}</span>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% schema %}
{
  "name": "Barra de Anuncios",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Mostrar barra de anuncios",
      "default": true
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Mensaje 1 (izquierda)",
      "default": "ENVÍO GRATIS POR COMPRAS SUPERIORES A $250.000 COP"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Mensaje 2 (centro)",
      "default": "PAGO CONTRA ENTREGA — CONFIRMA POR WHATSAPP"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "Mensaje 3 (derecha)",
      "default": "GARANTÍA CERTIFICADA 1 AÑO EN ORO LAMINADO 18K"
    }
  ],
  "presets": [
    {
      "name": "Barra de Anuncios",
      "category": "Encabezado"
    }
  ]
}
{% endschema %}
