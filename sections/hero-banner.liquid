{%- comment -%}
  Hero Banner Section for JSG GOLD (Luxury Royal Crest & Metallic Branding)
{%- endcomment -%}

<section class="hero-banner-section" style="position: relative; background: radial-gradient(circle at 50% 20%, #151821 0%, #07080a 80%); color: #ffffff; padding: 90px 0 80px 0; overflow: hidden; border-bottom: 3px solid var(--gold-primary);">
  
  <!-- Ambient background glow -->
  <div style="position: absolute; top: 30%; left: 50%; transform: translate(-50%, -50%); width: 700px; height: 500px; background: radial-gradient(circle, rgba(212, 175, 55, 0.22) 0%, rgba(7, 8, 10, 0) 70%); pointer-events: none; z-index: 1;"></div>

  <!-- Background image overlay if configured -->
  {% if section.settings.image != blank %}
    <div style="position: absolute; top:0; left:0; width:100%; height:100%; opacity: 0.25; z-index: 1;">
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title }}" style="width:100%; height:100%; object-fit: cover;">
    </div>
  {% endif %}

  <div class="container" style="position: relative; z-index: 2; max-width: 950px; text-align: center; margin: 0 auto; padding: 0 20px;">
    
    <!-- ROYAL JSG GOLD CREST LOGO -->
    <div style="margin-bottom: 25px; display: flex; justify-content: center; align-items: center; flex-direction: column;">
      <div style="position: relative; width: 140px; height: 140px; border-radius: 50%; background: #000; padding: 5px; border: 2px solid var(--gold-primary); box-shadow: 0 0 35px rgba(212, 175, 55, 0.45); transition: transform 0.4s ease;" class="hover-lift">
        <img src="{{ 'jsg-gold-logo.jpg' | asset_url }}" alt="JSG GOLD 18K Logo Official" style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
      </div>
      
      <div style="margin-top: 15px; display: inline-flex; align-items: center; gap: 10px; background: rgba(212, 175, 55, 0.12); border: 1px solid var(--gold-primary); padding: 6px 22px; border-radius: 50px; box-shadow: 0 4px 20px rgba(212, 175, 55, 0.15);">
        <span style="color: var(--gold-light); font-weight: 800; font-size: 0.85rem; letter-spacing: 3px; text-transform: uppercase;">
          ✦ TIENDA OFICIAL JSG GOLD 18K ✦
        </span>
      </div>
    </div>

    <!-- MAIN BRAND TITLE -->
    <h1 style="font-family: var(--font-display); font-size: clamp(2.8rem, 6.5vw, 4.8rem); font-weight: 900; text-transform: uppercase; letter-spacing: 3px; line-height: 1.05; margin-bottom: 18px; text-shadow: 0 5px 30px rgba(0,0,0,0.9);">
      <span class="gold-shimmer-text" style="display: block;">
        JSG GOLD
      </span>
      <span style="color: #ffffff; font-size: 0.45em; font-weight: 700; letter-spacing: 4px; display: block; margin-top: 10px; text-transform: uppercase; opacity: 0.95;">
        JOYERÍA MASCULINA EN ORO LAMINADO 18K
      </span>
    </h1>

    <!-- Subtitle Description -->
    <p style="font-size: 1.15rem; color: #D0D5DD; max-width: 740px; margin: 0 auto 38px auto; line-height: 1.7; font-weight: 400;">
      {{ section.settings.description | default: 'Cadenas, pulseras y dijes macizos diseñados para marcar presencia. Elaborados con 3 capas térmicas de oro de 18K sobre base técnica indeformable. Soportan agua, mar, gimnasio y lociones. 1 año de garantía escrita.' }}
    </p>

    <!-- ACTION BUTTONS -->
    <div style="display: flex; gap: 18px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 50px;">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-gold shine-hover btn-lg" style="padding: 16px 40px; font-size: 1.05rem; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase; box-shadow: 0 12px 35px rgba(212, 175, 55, 0.45);">
        {{ section.settings.button_label | default: 'VER CATÁLOGO COMPLETO' }}
      </a>
      <a href="https://api.whatsapp.com/send?phone={{ settings.whatsapp_number }}&text=Hola%20JSG%20Gold,%20deseo%20asesoría%20para%20realizar%20un%20pedido%20con%20Pago%20Contra%20Entrega." target="_blank" class="btn btn-whatsapp btn-lg" style="padding: 16px 34px; font-size: 1.05rem; font-weight: 800; display: inline-flex; align-items: center; gap: 10px;">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="#ffffff"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>PEDIR POR WHATSAPP (CONTRA ENTREGA)</span>
      </a>
    </div>

    <!-- TRUST FEATURE BADGES BAR -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; background: rgba(18, 20, 24, 0.9); backdrop-filter: blur(12px); border: 1px solid var(--gold-border); border-radius: 14px; padding: 22px 18px; max-width: 920px; margin: 0 auto; box-shadow: 0 15px 35px rgba(0,0,0,0.3);">
      
      <div style="display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 0.9rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.4rem;">🚚</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px;">ENVÍOS GRATIS</strong>
          <span>A toda Colombia</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 0.9rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.4rem;">💵</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px;">CONTRA ENTREGA</strong>
          <span>Pagas al recibir</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 0.9rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.4rem;">🛡️</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px;">GARANTÍA 1 AÑO</strong>
          <span>Certificado escrito</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 0.9rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.4rem;">👑</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 1px;">ORO LAMINADO 18K</strong>
          <span>3 Capas Reales</span>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Royal JSG",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "TIENDA OFICIAL JSG GOLD 18K"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "JSG GOLD"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Cadenas, pulseras y dijes macizos diseñados para marcar presencia. Elaborados con 3 capas térmicas de oro de 18K sobre base técnica indeformable. Soportan agua, mar, gimnasio y lociones. 1 año de garantía escrita."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del Botón",
      "default": "VER CATÁLOGO COMPLETO"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del Botón"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de Fondo (Opcional)"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Royal JSG"
    }
  ]
}
{% endschema %}
