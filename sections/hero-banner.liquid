{%- comment -%}
  Hero Banner Section for JSG GOLD (Matches User Reference Design)
{%- endcomment -%}

<section class="hero-banner-section" style="position: relative; min-height: 85vh; background: #07080a; color: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 2px solid var(--gold-primary);">

  <!-- Background image overlay -->
  <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;">
    <img src="{{ 'jsg-hero-bg.jpg' | asset_url }}" alt="JSG GOLD 18K Luxury Jewelry" style="width: 100%; height: 100%; object-fit: cover; object-position: center;">
    <!-- Dark gradient overlay for extreme readability and mood -->
    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at 40% 50%, rgba(7,8,10,0.75) 0%, rgba(7,8,10,0.94) 85%);"></div>
  </div>

  <div class="container" style="position: relative; z-index: 2; max-width: 900px; text-align: center; margin: 0 auto; padding: 60px 20px;">

    <!-- Subtitle Line -->
    <div style="display: flex; align-items: center; justify-content: center; gap: 15px; margin-bottom: 22px;">
      <span style="display: inline-block; width: 40px; height: 1px; background: var(--gold-primary);"></span>
      <span style="font-family: var(--font-display); font-size: 0.85rem; font-weight: 700; letter-spacing: 3px; color: var(--gold-light); text-transform: uppercase;">
        COLECCIÓN EXCLUSIVA 2026
      </span>
      <span style="display: inline-block; width: 40px; height: 1px; background: var(--gold-primary);"></span>
    </div>

    <!-- MAIN HEADLINE -->
    <h1 style="font-family: var(--font-display); font-size: clamp(2.8rem, 6.5vw, 5rem); font-weight: 900; text-transform: uppercase; letter-spacing: 3px; line-height: 1.08; margin-bottom: 25px; text-shadow: 0 4px 25px rgba(0,0,0,0.9);">
      <span style="color: #ffffff; display: block;">EL ORO</span>
      <span class="gold-shimmer-text" style="display: block;">HABLA POR SÍ SOLO</span>
    </h1>

    <!-- Description -->
    <p style="font-size: 1.15rem; color: #D0D5DD; max-width: 680px; margin: 0 auto 40px auto; line-height: 1.7; font-weight: 400; text-shadow: 0 2px 10px rgba(0,0,0,0.8);">
      Joyería en oro laminado 18k de alta durabilidad. Cada pieza diseñada para quienes saben que los detalles definen el estilo.
    </p>

    <!-- DUAL BUTTONS -->
    <div style="display: flex; gap: 20px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 50px;">
      <a href="/collections/all" class="btn btn-gold shine-hover btn-lg" style="padding: 16px 38px; font-size: 0.95rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);">
        EXPLORAR CATÁLOGO
      </a>
      
      <a href="#about-jsg" class="btn btn-dark btn-lg" style="padding: 16px 36px; font-size: 0.95rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; border-color: var(--gold-primary); color: var(--gold-light);">
        NUESTRA HISTORIA
      </a>
    </div>

    <!-- TRUST BADGES STRIP -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px; background: rgba(10, 11, 13, 0.85); backdrop-filter: blur(10px); border: 1px solid var(--gold-border); border-radius: 12px; padding: 18px 15px; max-width: 850px; margin: 0 auto;">
      
      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 0.85rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.2rem;">🚚</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.75rem; text-transform: uppercase;">ENVÍO GRATIS</strong>
          <span>Desde $150.000 COP</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 0.85rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.2rem;">💵</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.75rem; text-transform: uppercase;">CONTRA ENTREGA</strong>
          <span>Pagas al recibir</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 0.85rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.2rem;">✨</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.75rem; text-transform: uppercase;">CALIDAD PREMIUM</strong>
          <span>Oro Laminado 18K</span>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Reference",
  "settings": [],
  "presets": [
    { "name": "Hero Banner Reference" }
  ]
}
{% endschema %}
