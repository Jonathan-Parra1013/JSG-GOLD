{%- comment -%}
  Hero Banner Section for JSG GOLD
{%- endcomment -%}

<section class="hero-banner" style="position: relative; background: #000; color: #fff; padding: 100px 0; text-align: center; overflow: hidden; border-bottom: 2px solid var(--color-gold);">
  {% if section.settings.image != blank %}
    <div class="hero-bg" style="position: absolute; top:0; left:0; width:100%; height:100%; opacity: 0.35; z-index: 1;">
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title }}" style="width:100%; height:100%; object-fit: cover;">
    </div>
  {% else %}
    <div class="hero-bg" style="position: absolute; top:0; left:0; width:100%; height:100%; background: radial-gradient(circle, rgba(212,175,55,0.15) 0%, rgba(10,10,10,1) 80%); z-index: 1;"></div>
  {% endif %}

  <div class="container" style="position: relative; z-index: 2; max-width: 900px; margin: 0 auto; padding: 0 20px;">
    {% if section.settings.subtitle != blank %}
      <span style="color: var(--color-gold); font-weight: 700; letter-spacing: 3px; text-transform: uppercase; font-size: 0.9rem; display: block; margin-bottom: 15px;">
        {{ section.settings.subtitle }}
      </span>
    {% endif %}

    <h1 style="font-family: var(--font-heading); font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 700; color: #ffffff; text-transform: uppercase; letter-spacing: 2px; line-height: 1.25; margin-bottom: 20px;">
      {{ section.settings.title | default: 'Joyería Masculina de Alta Calidad en Oro Laminado 18K' }}
    </h1>

    <p style="font-size: 1.15rem; color: #d0d0d0; max-width: 680px; margin: 0 auto 35px auto; line-height: 1.6;">
      {{ section.settings.description | default: 'Cadenas, pulseras y dijes diseñados para marcar presencia. Resistencia garantizada al agua, sudor y lociones. Pago únicamente contra entrega a toda Colombia.' }}
    </p>

    <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-primary btn-lg">
        {{ section.settings.button_label | default: 'Ver Catálogo Completo' }}
      </a>
      <a href="https://api.whatsapp.com/send?phone={{ settings.whatsapp_number }}&text=Hola%20JSG%20Gold,%20deseo%20asesoría%20para%20un%20pedido%20con%20Pago%20Contra%20Entrega." target="_blank" class="btn btn-secondary btn-lg">
        Pedir por WhatsApp
      </a>
    </div>

    <!-- Free shipping pill -->
    <div style="margin-top: 40px; display: inline-flex; align-items: center; gap: 8px; background: rgba(212,175,55,0.12); border: 1px solid var(--color-gold); padding: 8px 18px; border-radius: 30px; font-size: 0.85rem; font-weight: 600; color: var(--color-gold-light);">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span>PAGO CONTRA ENTREGA EN TODO COLOMBIA | RECIBES Y PAGAS</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "EDICIÓN LIMITADA | JSG GOLD"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "ELEGANCIA Y PODER EN ORO LAMINADO 18K"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Joyería para hombres con carácter. Piezas macizas en oro laminado de 18K respaldadas con garantía de 1 año."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del Botón",
      "default": "Explorar Colección"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del Botón"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de Fondo"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
