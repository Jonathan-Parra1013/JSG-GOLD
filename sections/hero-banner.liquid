{%- comment -%}
  Hero Banner Section for JSG GOLD (Luxury Dark & Gold Aesthetic)
{%- endcomment -%}

<section class="hero-banner-section" style="position: relative; background: #07080a; color: #ffffff; padding: 110px 0 90px 0; overflow: hidden; border-bottom: 3px solid var(--gold-primary);">
  
  <!-- Ambient background glow -->
  <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; max-width: 900px; height: 500px; background: radial-gradient(circle, rgba(212, 175, 55, 0.18) 0%, rgba(10, 11, 13, 0) 70%); pointer-events: none; z-index: 1;"></div>

  <!-- Background image overlay if configured -->
  {% if section.settings.image != blank %}
    <div style="position: absolute; top:0; left:0; width:100%; height:100%; opacity: 0.28; z-index: 1;">
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title }}" style="width:100%; height:100%; object-fit: cover;">
    </div>
  {% endif %}

  <div class="container" style="position: relative; z-index: 2; max-width: 950px; text-align: center; margin: 0 auto; padding: 0 20px;">
    
    <!-- Gold Badge Pill -->
    <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(212, 175, 55, 0.12); border: 1px solid var(--gold-primary); padding: 8px 20px; border-radius: 50px; margin-bottom: 25px; box-shadow: 0 4px 20px rgba(212, 175, 55, 0.15);">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #D4AF37; box-shadow: 0 0 10px #D4AF37;"></span>
      <span style="font-family: var(--font-body); font-weight: 700; font-size: 0.85rem; letter-spacing: 2px; color: var(--gold-light); text-transform: uppercase;">
        {{ section.settings.subtitle | default: 'COLECCIÓN EXCLUSIVA 2026 | ORO LAMINADO 18K' }}
      </span>
    </div>

    <!-- Main Headline -->
    <h1 style="font-family: var(--font-display); font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 800; text-transform: uppercase; letter-spacing: 2px; line-height: 1.15; margin-bottom: 25px; text-shadow: 0 5px 25px rgba(0,0,0,0.8);">
      <span style="background: var(--gold-metallic); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; display: block;">
        {{ section.settings.title | default: 'DISTINCIÓN & PODER MASCULINO' }}
      </span>
      <span style="color: #ffffff; font-size: 0.75em; font-weight: 600; display: block; margin-top: 5px;">
        JOYERÍA EN ORO LAMINADO 18K
      </span>
    </h1>

    <!-- Subtitle Description -->
    <p style="font-size: 1.15rem; color: #D0D5DD; max-width: 720px; margin: 0 auto 40px auto; line-height: 1.7; font-weight: 300;">
      {{ section.settings.description | default: 'Cadenas, pulseras y dijes macizos elaborados con 3 capas de oro de 18K sobre base técnica indeformable. Soportan agua, mar, gimnasio y lociones sin perder su color. Respaldo directo de 1 año de garantía.' }}
    </p>

    <!-- CTAs -->
    <div style="display: flex; gap: 18px; justify-content: center; align-items: center; flex-wrap: wrap; margin-bottom: 50px;">
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-primary btn-lg" style="padding: 16px 36px; font-size: 1rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);">
        {{ section.settings.button_label | default: 'VER CATÁLOGO COMPLETO' }}
      </a>
      <a href="https://api.whatsapp.com/send?phone={{ settings.whatsapp_number }}&text=Hola%20JSG%20Gold,%20deseo%20asesoría%20para%20realizar%20un%20pedido%20con%20Pago%20Contra%20Entrega." target="_blank" class="btn btn-secondary btn-lg" style="padding: 16px 32px; font-size: 1rem; font-weight: 700; border-color: #25D366; color: #ffffff; background: rgba(37, 211, 102, 0.1); display: inline-flex; align-items: center; gap: 10px;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
        <span>Pedir por WhatsApp (Contra Entrega)</span>
      </a>
    </div>

    <!-- Trust Feature Badges Bar -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; background: rgba(18, 20, 24, 0.85); backdrop-filter: blur(10px); border: 1px solid var(--gold-border); border-radius: 12px; padding: 20px 15px; max-width: 900px; margin: 0 auto;">
      
      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 0.88rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.3rem;">🚚</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.8rem; text-transform: uppercase;">ENVÍOS GRATIS</strong>
          <span>A toda Colombia</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 0.88rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.3rem;">💵</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.8rem; text-transform: uppercase;">CONTRA ENTREGA</strong>
          <span>Pagas al recibir</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 0.88rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.3rem;">🛡️</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.8rem; text-transform: uppercase;">GARANTÍA 1 AÑO</strong>
          <span>Certificado escrito</span>
        </div>
      </div>

      <div style="display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 0.88rem; font-weight: 700; color: #F0F0F0;">
        <span style="font-size: 1.3rem;">👑</span>
        <div style="text-align: left;">
          <strong style="display: block; color: var(--gold-light); font-size: 0.8rem; text-transform: uppercase;">ORO LAMINADO 18K</strong>
          <span>3 Capas Reales</span>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero Banner Luxury",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "COLECCIÓN EXCLUSIVA 2026 | ORO LAMINADO 18K"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título Principal",
      "default": "DISTINCIÓN & PODER MASCULINO"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Cadenas, pulseras y dijes macizos elaborados con 3 capas de oro de 18K sobre base técnica indeformable. Soportan agua, mar, gimnasio y lociones sin perder su color. Respaldo directo de 1 año de garantía."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del Botón",
      "default": "VER CATÁLOGO COMPLETO"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del Botón"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de Fondo (Opcional)"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner Luxury"
    }
  ]
}
{% endschema %}
