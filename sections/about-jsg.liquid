{%- comment -%}
  About JSG Section for JSG GOLD (Sobre Nosotros & Comparación Oro 18K)
{%- endcomment -%}

<section class="section" id="about-jsg" style="padding: 85px 0; background: #ffffff;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 60px; align-items: center;">
      
      <div>
        <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(212, 175, 55, 0.12); border: 1px solid var(--gold-primary); padding: 6px 16px; border-radius: 30px; margin-bottom: 20px;">
          <span style="color: var(--gold-dark); font-weight: 800; letter-spacing: 2px; text-transform: uppercase; font-size: 0.78rem;">
            HISTORIA & CALIDAD
          </span>
        </div>

        <h2 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 2.6rem); font-weight: 900; color: var(--dark-primary); margin-bottom: 20px; line-height: 1.25; text-transform: uppercase;">
          JSG GOLD: DISTINCIÓN, MASCULINIDAD Y ELEGANCIA INALTERABLE
        </h2>
        
        <p style="color: #4A505C; line-height: 1.8; margin-bottom: 20px; font-size: 1.02rem;">
          En <strong style="color: var(--dark-primary);">JSG GOLD</strong> nos especializamos en diseñar e importar joyería masculina de alta gama elaborada en <strong style="color: var(--gold-dark);">Oro Laminado de 18 Kilates</strong>. Cada pieza cuenta con 3 capas térmicas compactadas de oro genuino sobre una base técnica ultra-resistente, logrando la densidad, el tono y la durabilidad idéntica al oro macizo comercial.
        </p>

        <p style="color: #4A505C; line-height: 1.8; margin-bottom: 35px; font-size: 1.02rem;">
          Olvídate de joyas que pierden su color o manchan tu piel. Nuestras piezas están diseñadas para tolerar el uso diario en gimnasio, mar, piscina y contacto con perfumes.
        </p>

        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
          <a href="https://api.whatsapp.com/send?phone={{ settings.whatsapp_number }}&text=Hola%20JSG%20Gold,%20deseo%20más%20información%20sobre%20la%20garantía%20del%20oro%20laminado." target="_blank" class="btn btn-gold shine-hover" style="padding: 14px 28px; font-weight: 800;">
            Asesoría Directa por WhatsApp
          </a>
          <a href="/collections/all" class="btn btn-dark" style="padding: 14px 28px; font-weight: 700;">
            Explorar Catálogo
          </a>
        </div>
      </div>

      <!-- Comparison Card -->
      <div style="background: radial-gradient(circle at top left, #1a1d24, #0a0b0d); color: #fff; border-radius: 16px; padding: 40px 32px; border: 1px solid var(--gold-primary); box-shadow: 0 20px 40px rgba(0,0,0,0.25); position: relative; overflow: hidden;">
        <div style="position: absolute; top: -50px; right: -50px; width: 150px; height: 150px; background: rgba(212,175,55,0.15); border-radius: 50%; filter: blur(30px); pointer-events: none;"></div>

        <h3 style="font-family: var(--font-display); color: var(--gold-light); font-size: 1.4rem; margin-bottom: 25px; text-align: center; text-transform: uppercase; letter-spacing: 1px; font-weight: 800;">
          ¿Por qué elegir JSG GOLD 18K?
        </h3>

        <div style="display: flex; flex-direction: column; gap: 18px; font-size: 0.92rem;">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
            <span style="color: #999;">Característica</span>
            <span style="color: var(--gold-light); font-weight: 800;">JSG GOLD 18K</span>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
            <span style="color: #ddd;">Resistencia al Agua / Sudor</span>
            <span style="color: #10B981; font-weight: 700; display: flex; align-items: center; gap: 5px;">
              <span>✓ 100% Garantizado</span>
            </span>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
            <span style="color: #ddd;">Apariencia & Tono</span>
            <span style="color: #ffffff; font-weight: 700;">Idéntico al Oro Macizo</span>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
            <span style="color: #ddd;">Garantía Directa</span>
            <span style="color: var(--gold-light); font-weight: 800;">1 Año por Escrito</span>
          </div>

          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 12px;">
            <span style="color: #ddd;">Método de Pago</span>
            <span style="color: #10B981; font-weight: 700;">Pago Contra Entrega</span>
          </div>

          <div style="display: flex; justify-content: space-between; padding-top: 5px;">
            <span style="color: #ddd;">Precio vs Oro Puro</span>
            <span style="color: var(--gold-light); font-weight: 800;">Ahorro del 90%</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About JSG",
  "presets": [
    {
      "name": "About JSG"
    }
  ]
}
{% endschema %}
