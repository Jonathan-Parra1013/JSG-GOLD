{%- comment -%}
  About JSG Section for JSG GOLD (Sobre Nosotros & Comparación Oro 18K)
{%- endcomment -%}

<section class="section" style="padding: 70px 0; background: #ffffff;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 50px; align-items: center;">
      <div>
        <span style="color: var(--color-gold-dark); font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-size: 0.85rem; display: block; margin-bottom: 10px;">
          SOBRE JSG GOLD
        </span>
        <h2 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--color-black); margin-bottom: 20px; line-height: 1.3;">
          DISTINCIÓN, MASCULINIDAD Y ELEGANCIA INALTERABLE
        </h2>
        <p style="color: #555; line-height: 1.7; margin-bottom: 20px;">
          En <strong>JSG Gold</strong> nos especializamos en diseñar e importar joyería masculina de alta gama elaborada en <strong>Oro Laminado de 18 Kilates</strong>. Cada pieza cuenta con 3 capas compactadas de oro genuino sobre una base técnica ultra-resistente, logrando el peso, brillo y durabilidad exacta del oro macizo.
        </p>
        <p style="color: #555; line-height: 1.7; margin-bottom: 30px;">
          Olvídate de joyas que pierden su color. Nuestras piezas toleran el uso diario en gimnasio, mar, piscinas y contacto con lociones.
        </p>

        <a href="https://api.whatsapp.com/send?phone={{ settings.whatsapp_number }}&text=Hola%20JSG%20Gold,%20deseo%20más%20información%20sobre%20la%20garantía%20del%20oro%20laminado." target="_blank" class="btn btn-primary">
          Consultar por WhatsApp
        </a>
      </div>

      <!-- Comparison Table Card -->
      <div style="background: #0a0a0a; color: #fff; border-radius: 12px; padding: 35px 30px; border: 1px solid var(--color-gold); box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
        <h3 style="font-family: var(--font-heading); color: var(--color-gold); font-size: 1.3rem; margin-bottom: 25px; text-align: center; text-transform: uppercase; letter-spacing: 1px;">
          ¿Por qué elegir Oro Laminado 18K?
        </h3>

        <div style="display: flex; flex-direction: column; gap: 15px; font-size: 0.9rem;">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 10px;">
            <span style="color: #aaa;">Característica</span>
            <span style="color: var(--color-gold); font-weight: 700;">JSG Gold 18K</span>
          </div>
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 10px;">
            <span style="color: #ccc;">Resistencia al Agua / Sudor</span>
            <span style="color: #4CAF50; font-weight: 600;">100% Resistente</span>
          </div>
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 10px;">
            <span style="color: #ccc;">Apariencia & Tono</span>
            <span style="color: #fff; font-weight: 600;">Idéntico al Oro Macizo</span>
          </div>
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 10px;">
            <span style="color: #ccc;">Garantía Directa</span>
            <span style="color: var(--color-gold); font-weight: 700;">1 Año Escrito</span>
          </div>
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 10px;">
            <span style="color: #ccc;">Método de Pago</span>
            <span style="color: #4CAF50; font-weight: 700;">Contra Entrega</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About JSG",
  "presets": [
    {
      "name": "About JSG"
    }
  ]
}
{% endschema %}
