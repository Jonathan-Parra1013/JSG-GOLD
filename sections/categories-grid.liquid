{%- comment -%}
  Categories Grid Section for JSG GOLD
{%- endcomment -%}

{%- assign cadenas_link = section.settings.cadenas_collection.url -%}
{%- if cadenas_link == blank -%}
  {%- if collections['cadenas'].handle != blank -%}
    {%- assign cadenas_link = '/collections/cadenas' -%}
  {%- else -%}
    {%- assign cadenas_link = '/collections/all?categoria=cadenas' -%}
  {%- endif -%}
{%- endif -%}

{%- assign pulseras_link = section.settings.pulseras_collection.url -%}
{%- if pulseras_link == blank -%}
  {%- if collections['pulseras'].handle != blank -%}
    {%- assign pulseras_link = '/collections/pulseras' -%}
  {%- else -%}
    {%- assign pulseras_link = '/collections/all?categoria=pulseras' -%}
  {%- endif -%}
{%- endif -%}

{%- assign dijes_link = section.settings.dijes_collection.url -%}
{%- if dijes_link == blank -%}
  {%- if collections['dijes'].handle != blank -%}
    {%- assign dijes_link = '/collections/dijes' -%}
  {%- else -%}
    {%- assign dijes_link = '/collections/all?categoria=dijes' -%}
  {%- endif -%}
{%- endif -%}

{%- assign combos_link = section.settings.combos_collection.url -%}
{%- if combos_link == blank -%}
  {%- if collections['combos'].handle != blank -%}
    {%- assign combos_link = '/collections/combos' -%}
  {%- else -%}
    {%- assign combos_link = '/collections/all?categoria=combos' -%}
  {%- endif -%}
{%- endif -%}

<section class="section" style="padding: 70px 0; background: #ffffff;">
  <div class="container">
    
    <div style="text-align: center; margin-bottom: 45px;">
      <span style="color: var(--gold-dark); font-weight: 800; letter-spacing: 2px; text-transform: uppercase; font-size: 0.85rem; display: block; margin-bottom: 8px;">
        CATEGORÍAS DE LUJO
      </span>
      <h2 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--dark-primary);">
        EXPLORA NUESTRAS COLECCIONES EN ORO 18K
      </h2>
      <div style="width: 70px; height: 3px; background: var(--gold-metallic); margin: 15px auto 0 auto; border-radius: 2px;"></div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 25px;">
      
      <!-- Category 1: Cadenas -->
      <a href="{{ cadenas_link }}" class="category-card" style="position: relative; height: 320px; border-radius: 12px; overflow: hidden; background: #0a0b0d; display: flex; flex-direction: column; justify-content: flex-end; padding: 25px; border: 1px solid rgba(212,175,55,0.3); box-shadow: 0 8px 24px rgba(0,0,0,0.12); transition: transform 0.3s ease, box-shadow 0.3s ease; text-decoration: none;">
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.85) 100%); z-index: 1;"></div>
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background-image: radial-gradient(circle at center, rgba(212,175,55,0.15), transparent 70%); z-index: 0;"></div>
        
        <div style="position: relative; z-index: 2;">
          <span style="color: var(--gold-light); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: block; margin-bottom: 5px;">
            MÁS POPULAR
          </span>
          <h3 style="font-family: var(--font-display); font-size: 1.5rem; color: #ffffff; font-weight: 800; margin-bottom: 8px; text-transform: uppercase;">
            CADENAS 18K
          </h3>
          <p style="color: #cccccc; font-size: 0.85rem; margin-bottom: 15px; font-weight: 400;">
            Tejido Cubano, Chino, Escalera y Cartie en grosores de 3mm a 12mm.
          </p>
          <span style="display: inline-flex; align-items: center; gap: 8px; color: var(--gold-primary); font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">
            <span>Ver Cadenas</span> &rarr;
          </span>
        </div>
      </a>

      <!-- Category 2: Pulseras -->
      <a href="{{ pulseras_link }}" class="category-card" style="position: relative; height: 320px; border-radius: 12px; overflow: hidden; background: #0a0b0d; display: flex; flex-direction: column; justify-content: flex-end; padding: 25px; border: 1px solid rgba(212,175,55,0.3); box-shadow: 0 8px 24px rgba(0,0,0,0.12); transition: transform 0.3s ease, box-shadow 0.3s ease; text-decoration: none;">
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.85) 100%); z-index: 1;"></div>
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background-image: radial-gradient(circle at center, rgba(212,175,55,0.15), transparent 70%); z-index: 0;"></div>
        
        <div style="position: relative; z-index: 2;">
          <span style="color: var(--gold-light); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: block; margin-bottom: 5px;">
            PRESENCIA & ESTILO
          </span>
          <h3 style="font-family: var(--font-display); font-size: 1.5rem; color: #ffffff; font-weight: 800; margin-bottom: 8px; text-transform: uppercase;">
            PULSERAS 18K
          </h3>
          <p style="color: #cccccc; font-size: 0.85rem; margin-bottom: 15px; font-weight: 400;">
            Brazaletes y pulseras macizas con broches de seguridad reforzados.
          </p>
          <span style="display: inline-flex; align-items: center; gap: 8px; color: var(--gold-primary); font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">
            <span>Ver Pulseras</span> &rarr;
          </span>
        </div>
      </a>

      <!-- Category 3: Dijes -->
      <a href="{{ dijes_link }}" class="category-card" style="position: relative; height: 320px; border-radius: 12px; overflow: hidden; background: #0a0b0d; display: flex; flex-direction: column; justify-content: flex-end; padding: 25px; border: 1px solid rgba(212,175,55,0.3); box-shadow: 0 8px 24px rgba(0,0,0,0.12); transition: transform 0.3s ease, box-shadow 0.3s ease; text-decoration: none;">
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.85) 100%); z-index: 1;"></div>
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background-image: radial-gradient(circle at center, rgba(212,175,55,0.15), transparent 70%); z-index: 0;"></div>
        
        <div style="position: relative; z-index: 2;">
          <span style="color: var(--gold-light); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: block; margin-bottom: 5px;">
            DETALLES ÚNICOS
          </span>
          <h3 style="font-family: var(--font-display); font-size: 1.5rem; color: #ffffff; font-weight: 800; margin-bottom: 8px; text-transform: uppercase;">
            DIJES & MEDALLAS
          </h3>
          <p style="color: #cccccc; font-size: 0.85rem; margin-bottom: 15px; font-weight: 400;">
            Cristos, Cruces, Placas y símbolos tallados en oro laminado de 18K.
          </p>
          <span style="display: inline-flex; align-items: center; gap: 8px; color: var(--gold-primary); font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">
            <span>Ver Dijes</span> &rarr;
          </span>
        </div>
      </a>

      <!-- Category 4: Combos -->
      <a href="{{ combos_link }}" class="category-card" style="position: relative; height: 320px; border-radius: 12px; overflow: hidden; background: #0a0b0d; display: flex; flex-direction: column; justify-content: flex-end; padding: 25px; border: 1px solid rgba(212,175,55,0.3); box-shadow: 0 8px 24px rgba(0,0,0,0.12); transition: transform 0.3s ease, box-shadow 0.3s ease; text-decoration: none;">
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.85) 100%); z-index: 1;"></div>
        <div style="position: absolute; top:0; left:0; width:100%; height:100%; background-image: radial-gradient(circle at center, rgba(212,175,55,0.15), transparent 70%); z-index: 0;"></div>
        
        <div style="position: relative; z-index: 2;">
          <span style="color: var(--gold-light); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; display: block; margin-bottom: 5px;">
            AHORRO ESPECIAL
          </span>
          <h3 style="font-family: var(--font-display); font-size: 1.5rem; color: #ffffff; font-weight: 800; margin-bottom: 8px; text-transform: uppercase;">
            COMBOS 18K
          </h3>
          <p style="color: #cccccc; font-size: 0.85rem; margin-bottom: 15px; font-weight: 400;">
            Kits completísimos de Cadena + Dije + Pulsera a precio de oferta.
          </p>
          <span style="display: inline-flex; align-items: center; gap: 8px; color: var(--gold-primary); font-weight: 700; font-size: 0.85rem; text-transform: uppercase;">
            <span>Ver Combos</span> &rarr;
          </span>
        </div>
      </a>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Categorías de Lujo",
  "settings": [
    {
      "type": "collection",
      "id": "cadenas_collection",
      "label": "Colección de Cadenas",
      "info": "Si no se selecciona, enlazará automáticamente a /collections/cadenas"
    },
    {
      "type": "collection",
      "id": "pulseras_collection",
      "label": "Colección de Pulseras",
      "info": "Si no se selecciona, enlazará automáticamente a /collections/pulseras"
    },
    {
      "type": "collection",
      "id": "dijes_collection",
      "label": "Colección de Dijes & Medallas",
      "info": "Si no se selecciona, enlazará automáticamente a /collections/dijes"
    },
    {
      "type": "collection",
      "id": "combos_collection",
      "label": "Colección de Combos",
      "info": "Si no se selecciona, enlazará automáticamente a /collections/combos"
    }
  ],
  "presets": [
    {
      "name": "Categorías de Lujo"
    }
  ]
}
{% endschema %}
